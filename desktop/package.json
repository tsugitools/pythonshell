{
  "name": "pythonshell-desktop",
  "productName": "PythonShell",
  "version": "0.9.3",
  "description": "PythonShell desktop playground — in-app Python with Pyodide, workspace in localStorage.",
  "author": "Python for Everybody",
  "license": "Apache-2.0",
  "homepage": "https://www.py4e.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mas": "test -f build/embedded.provisionprofile || { echo 'Missing build/embedded.provisionprofile. Download a Mac App Store profile from https://developer.apple.com/account/resources/profiles/list and save it there.'; exit 1; }; electron-builder --mac mas --universal --publish never",
    "dist:mas:dev": "electron-builder --mac mas-dev --universal --publish never",
    "dist:win": "electron-builder --win nsis appx --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.learnxp.pythonshell",
    "productName": "PythonShell",
    "copyright": "Copyright © Python for Everybody",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "icons"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../index.html",
        "to": "web/index.html"
      },
      {
        "from": "../static",
        "to": "web/static"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "mac": {
      "category": "public.app-category.education",
      "icon": "icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "mas": {
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "entitlementsLoginHelper": "build/entitlements.mas.loginhelper.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "category": "public.app-category.education",
      "type": "distribution"
    },
    "masDev": {
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "entitlementsLoginHelper": "build/entitlements.mas.loginhelper.plist",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "identityName": "Dr.Chuck.PythonShell",
      "applicationId": "PythonShell",
      "publisher": "CN=8B24B106-488C-4DBE-B74E-F87CA3ECF9DC",
      "publisherDisplayName": "Dr. Chuck",
      "displayName": "PythonShell",
      "backgroundColor": "#0b6e4f",
      "showNameOnTiles": true,
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "en-US"
      ]
    }
  }
}
